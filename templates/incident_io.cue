package templates

#Alert: {
	long:     string
	short:    string
	burn:     float
	severity: "page" | "message" | "ticket"
}

#Input: {
	slo_target:           float
	error_budget_ratio:   float
	total_window_seconds: float
	windows: [...#Alert]
	config?: {[string]: _}
}

// Data input
data: #Input

// Configuration helpers
_config: {
	name:         *data.config.name | "SLO Alert Source"
	service_name: *data.config.service_name | "my-service"
	metric_name:  *data.config.metric_name | "slo_errors"
	source_type:  *data.config.source_type | "custom"
	runbook_url:  *data.config.runbook_url | ""
	
	// Incident urgency / severity mapping
	severity_map: {
		page:    *(data.config.severity_map.page) | "critical"
		message: *(data.config.severity_map.message) | "major"
		ticket:  *(data.config.severity_map.ticket) | "minor"
	}
}

// Incident.io Alert Source configuration structure
name:        _config.name
description: "Generated by sloak for \(_config.service_name) (SLO target: \(data.slo_target)%)"
source_type: _config.source_type

// Alert routing definitions mapping multi-window severities to incident handling
routes: [
	{
		name:      "High Burn Rate (Page)"
		condition: "labels.severity == 'page'"
		action: {
			create_incident:   true
			incident_mode:     "realtime"
			incident_severity: _config.severity_map.page
		}
	},
	{
		name:      "Elevated Burn Rate (Message)"
		condition: "labels.severity == 'message'"
		action: {
			create_incident:   false
			incident_mode:     "triage"
			incident_severity: _config.severity_map.message
		}
	},
	{
		name:      "Slow Burn Rate (Ticket)"
		condition: "labels.severity == 'ticket'"
		action: {
			create_incident:   false
			incident_mode:     "triage"
			incident_severity: _config.severity_map.ticket
		}
	},
]

// Deduplication configuration for ingested alerts
deduplication: {
	expressions: [
		"labels.alertname",
		"labels.severity",
		"labels.service",
	]
}

// Metadata with calculated SLO values for upstream platform audit & catalog sync
metadata: {
	service_name:         _config.service_name
	metric_name:          _config.metric_name
	slo_target:           data.slo_target
	error_budget_ratio:   data.error_budget_ratio
	total_window_seconds: data.total_window_seconds
	if _config.runbook_url != "" {
		runbook_url: _config.runbook_url
	}
	windows: [
		for a in data.windows {
			window_long:  a.long
			window_short: a.short
			burn_rate:    a.burn
			severity:     a.severity
		}
	]
}
