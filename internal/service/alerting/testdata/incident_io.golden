{
  "deduplication": {
    "expressions": [
      "labels.alertname",
      "labels.severity",
      "labels.service"
    ]
  },
  "description": "Generated by sloak for api-service (SLO target: 99.9%)",
  "metadata": {
    "service_name": "api-service",
    "metric_name": "api_errors",
    "slo_target": 99.9,
    "error_budget_ratio": 0.001,
    "total_window_seconds": 2592000,
    "windows": [
      {
        "window_long": "1h",
        "window_short": "5m",
        "burn_rate": 14.4,
        "severity": "page"
      },
      {
        "window_long": "6h",
        "window_short": "30m",
        "burn_rate": 6,
        "severity": "message"
      },
      {
        "window_long": "3d",
        "window_short": "6h",
        "burn_rate": 1,
        "severity": "ticket"
      }
    ]
  },
  "name": "SLO Alert Source",
  "routes": [
    {
      "name": "High Burn Rate (Page)",
      "condition": "labels.severity == 'page'",
      "action": {
        "create_incident": true,
        "incident_mode": "realtime",
        "incident_severity": "critical"
      }
    },
    {
      "name": "Elevated Burn Rate (Message)",
      "condition": "labels.severity == 'message'",
      "action": {
        "create_incident": false,
        "incident_mode": "triage",
        "incident_severity": "major"
      }
    },
    {
      "name": "Slow Burn Rate (Ticket)",
      "condition": "labels.severity == 'ticket'",
      "action": {
        "create_incident": false,
        "incident_mode": "triage",
        "incident_severity": "minor"
      }
    }
  ],
  "source_type": "custom"
}
