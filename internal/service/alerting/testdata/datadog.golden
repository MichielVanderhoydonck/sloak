{
  "description": "Datadog SLO automatically generated by sloak",
  "name": "My Service SLO",
  "query": {
    "numerator": "sum:api_errors{type:good}.as_count()",
    "denominator": "sum:api_errors{*}.as_count()"
  },
  "tags": [
    "env:prod",
    "service:my-service"
  ],
  "thresholds": [
    {
      "timeframe": "30d",
      "target": 99.9,
      "warning": 99.91
    }
  ],
  "type": "metric"
}
